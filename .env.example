# ==============================================================================
# SevaSetu Environment Variables Configuration
# ==============================================================================

# Server-Only: Google Gemini API Key (Strictly keep private, never prefix with NEXT_PUBLIC_)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Database Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Next.js Server Port (Default: 3000, Local dev fallback: 3002)
PORT=3000
NODE_ENV=production

# Sentry Error Monitoring (Optional for production)
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
